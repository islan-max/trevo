DATABASE_URL=postgresql://user:password@host:5432/dbname
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/ritmo_test
# Opcional: se ausente, o servidor gera um segredo na primeira execucao e o
# guarda na tabela app_secrets. Defina explicitamente se quiser controlar a
# rotacao (trocar o valor invalida todas as sessoes ativas).
JWT_SECRET_KEY=sua-chave-secreta-com-pelo-menos-32-caracteres
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
# Hosts aceitos no header Host (SEC-06). Sem isto, o redirect do fluxo OAuth
# (app/oauth.py) confia no Host da requisição sem checagem — um Host forjado
# produz um redirect para domínio arbitrário depois do login. Vazio por
# padrão (sem restrição) para não derrubar um ambiente com um allowlist
# errado; em produção, defina com o(s) domínio(s) público(s) exatos.
TRUSTED_HOSTS=
ENVIRONMENT=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_FORMAT=text
# Fuso usado para decisões de negócio (mês contábil, dia do calendário de
# metas) — app/shared/clock.py. datetime.now(UTC) direto trocava de mês até
# 3h antes da virada real no Brasil (DOM-04). Só mude se o público-alvo não
# for majoritariamente pt-BR.
APP_TIMEZONE=America/Sao_Paulo

# Supabase Storage (fotos de perfil em bucket privado). Obrigatorio em serverless
# (Vercel) porque o filesystem e efemero/read-only; opcional no dev (usa disco).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATARS_BUCKET=avatars

# Em producao:
# ENVIRONMENT=production
# ALLOWED_ORIGINS=  (vazio = mesma origem; no Vercel front e API ficam na mesma origem)
# TRUSTED_HOSTS=trevo-finance.vercel.app  (ajuste ao(s) domínio(s) público(s) reais)
# JWT_SECRET_KEY deve vir de um secret manager e ter pelo menos 32 caracteres.
# No Vercel, DATABASE_URL deve apontar para o TRANSACTION POOLER do Supabase (porta 6543).
# NEXT_PUBLIC_API_BASE_URL="" (vazio) no Vercel — mesma origem.
# VERCEL=1 e definido automaticamente pela plataforma.

# OAuth (opcional — login e-mail/senha funciona sem estas variáveis)
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
