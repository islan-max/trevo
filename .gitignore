# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.venv/
venv/
ENV/

# Node / Next.js
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Logs
*.log
logs/
fin.log

# Local data and uploads
data/
tmp/
temp/
uploads/
exports/
reports/generated/
artifacts/

# Generated reports (keep intentional examples under docs/examples/)
*.pdf
*.csv
*.docx
!docs/examples/**/*.csv
# Fixtures de teste (extratos bancários sintéticos) precisam ser versionadas —
# sem esta negação, *.csv acima as engoliria em silêncio, exatamente a classe
# de incidente que scripts/check-ignored-files.sh existe para prevenir.
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.pdf

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Agent / local tooling
.agents/
skills-lock.json

# Security — never commit secrets or keys
*.pem
*.key
*.crt
secrets.*
service-account*.json
